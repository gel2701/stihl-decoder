{
  "name": "stihl-decoder",
  "version": "1.0.0",
  "description": "STIHL Machine & Serienummer Decoder Tool - Onafhankelijke Stihl serienummer en gietnummer checker.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "build:css": "tailwindcss -i ./css/input.css -o ./css/tailwind.css --minify",
    "build": "npm run build:css",
    "test": "node tests/run_all_tests.js",
    "db:backup": "node scripts/db_backup.js",
    "data:rebuild": "node scripts/rebuild_canonical_data.js",
    "data:seed": "node data/seed.cjs",
    "audit:source-integrity": "node scripts/phase33e_source_integrity_audit.js",
    "audit:document-authority": "node scripts/phase35_document_authority_validation.js",
    "audit:https-production": "node scripts/live_https_production_crawl.js",
    "baseline:seo": "node scripts/build_phase34a_seo_baseline.js",
    "harvest:official:br": "node scripts/harvest_stihl_official_products.js",
    "harvest:official:smoke": "node scripts/harvest_stihl_official_products.js --limit 3 --concurrency 2",
    "freeze:test": "node scripts/verify_seo_freeze_negative.js"
  },
  "keywords": [
    "stihl",
    "serienummer",
    "decoder",
    "chainsaw",
    "kettingzaag",
    "bosmaaier",
    "teilenummer",
    "gussuhr"
  ],
  "author": "Gellius Snippe",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "html-to-image": "^1.11.13",
    "pdfjs-dist": "^6.2.108",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "fetch-stihl-products": "2.0.5",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  }
}
